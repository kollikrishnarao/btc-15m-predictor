# BTC-15m Predictor — Environment Variables
# Copy to .env and fill in values

# Anthropic API (required for LLM calls)
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_BASE_URL=https://api.opusmax.pro

# Polymarket (optional — for live trading)
POLYMARKET_API_KEY=
POLYMARKET_API_SECRET=

# Binance SOCKS5 proxy (required if server IP is geoblocked)
# Format: socks5://user:pass@host:port  or  socks5://host:port
BINANCE_PROXY=socks5://user:pass@your-proxy-host:1080

# Session persistence
SESSION_DB_PATH=./data/sessions.db

# Logging
LOG_LEVEL=INFO